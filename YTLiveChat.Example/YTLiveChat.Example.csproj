<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\YTLiveChat.DependencyInjection\YTLiveChat.DependencyInjection.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.13" />
  </ItemGroup>
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <TargetFrameworks>net11.0;net10.0</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <!-- A native executable ships no XML docs. The Compile-only AOT publish (dotnet/sdk#54515) also
         never copies them into OutDir, where publish looks (MSB3030). -->
    <PublishDocumentationFiles>false</PublishDocumentationFiles>
    <!-- PublishAot puts the runtime pack in the dependency graph, where the SDK baseline resolves to
         an unpatched 10.0.x. Pin the patched one so security scanning sees what actually ships. -->
    <RuntimeFrameworkVersion Condition="'$(TargetFramework)' == 'net10.0'"
      >10.0.12</RuntimeFrameworkVersion>
    <OptimizationPreference>speed</OptimizationPreference>
  </PropertyGroup>
</Project>
